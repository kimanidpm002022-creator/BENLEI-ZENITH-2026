generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  role      String   @default("customer")
  createdAt DateTime @default(now())
}

model Product {
  id         String   @id @default(cuid())
  sku        String?  @unique
  name       String
  description String?
  unitPrice  Float
  cost       Float?
  currency   String   @default("USD")
  stock      Int      @default(0)
  createdAt  DateTime @default(now())
}

model Vendor {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  address   String?
  createdAt DateTime @default(now())
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  address   String?
  createdAt DateTime @default(now())
}

model PurchaseOrder {
  id          String   @id @default(cuid())
  vendorId    String
  vendor      Vendor   @relation(fields: [vendorId], references: [id])
  number      String   @unique
  status      String   @default("draft")
  total       Float    @default(0)
  currency    String   @default("USD")
  createdAt   DateTime @default(now())
  lines       PurchaseOrderLine[]
}

model PurchaseOrderLine {
  id              String  @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  productId       String
  product         Product @relation(fields: [productId], references: [id])
  quantity        Int
  unitPrice       Float
  receivedQty     Int     @default(0)
}

model SalesOrder {
  id        String   @id @default(cuid())
  customerId String
  customer  Customer @relation(fields: [customerId], references: [id])
  number    String   @unique
  status    String   @default("draft")
  total     Float    @default(0)
  currency  String   @default("USD")
  createdAt DateTime @default(now())
  lines     SalesOrderLine[]
}

model SalesOrderLine {
  id          String @id @default(cuid())
  salesOrderId String
  salesOrder  SalesOrder @relation(fields: [salesOrderId], references: [id])
  productId   String
  product     Product @relation(fields: [productId], references: [id])
  quantity    Int
  unitPrice   Float
  shippedQty  Int @default(0)
}

model Invoice {
  id         String @id @default(cuid())
  number     String @unique
  type       String // 'customer' or 'vendor'
  referenceId String? // links to SalesOrder.id or PurchaseOrder.id
  partyId    String // customerId or vendorId
  total      Float
  currency   String @default("USD")
  status     String @default("draft")
  createdAt  DateTime @default(now())
  lines      InvoiceLine[]
}

model InvoiceLine {
  id        String @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Float
}

model AccountingAccount {
  id        String @id @default(cuid())
  code      String @unique
  name      String
  type      String // Asset, Liability, Equity, Income, Expense
}

model JournalEntry {
  id        String @id @default(cuid())
  date      DateTime @default(now())
  memo      String?
  lines     JournalEntryLine[]
}

model JournalEntryLine {
  id            String @id @default(cuid())
  journalEntryId String
  journalEntry  JournalEntry @relation(fields: [journalEntryId], references: [id])
  accountId     String
  account       AccountingAccount @relation(fields: [accountId], references: [id])
  debit         Float @default(0)
  credit        Float @default(0)
}

model InventoryTransaction {
  id         String @id @default(cuid())
  productId  String
  product    Product @relation(fields: [productId], references: [id])
  type       String // receipt, shipment, adjustment
  quantity   Int
  unitCost   Float?
  createdAt  DateTime @default(now())
}

model Setting {
  key   String @id
  value String
}

// Prisma schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id         String   @id @default(cuid())
  name       String
  shortDesc  String?
  longDesc   String?
  price      Float
  currency   String  @default("USD")
  sku        String? @unique
  stock      Int     @default(0)
  image      String?
  published  Boolean @default(true)
  createdAt  DateTime @default(now())
}

model User {
  id       String @id @default(cuid())
  name     String?
  email    String @unique
  role     String  @default("customer")
  createdAt DateTime @default(now())
}

model Order {
  id        String @id @default(cuid())
  userId    String
  productId String
  quantity  Int
  total     Float
  status    String @default("pending")
  createdAt DateTime @default(now())
}

model Category {
  id    String @id @default(cuid())
  name  String
  slug  String @unique
}

model Setting {
  key   String @id
  value String
}

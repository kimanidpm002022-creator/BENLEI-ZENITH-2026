# Environment variables for local development (copy to .env)

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/benlei_zenith_dev?schema=public"

# NextAuth / Email
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-secure-random-string"
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

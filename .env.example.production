# Environment variables for production on Vercel

# Database (Postgres recommended)
DATABASE_URL="postgresql://user:password@host:5432/benlei_zenith_prod?schema=public"

# NextAuth
NEXTAUTH_URL="https://your-vercel-domain.vercel.app"
NEXTAUTH_SECRET="generate-a-secure-random-string"

# Email provider (optional, used for magic links in production)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="no-reply@your-domain.com"

# Seed admin email (optional - do NOT seed in production unless deliberate)
SEED_ADMIN_EMAIL=admin@your-domain.com

# GitHub OAuth (optional)
GITHUB_ID=
GITHUB_SECRET=

# Stripe (optional)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
